; ============================================================
;  SyncAgent — Configuração
;  Preencha apenas os campos marcados com <-- ALTERAR
; ============================================================

[postgres]
host     =                           <-- ALTERAR (host do Postgres)
port     = 5432
database = enviadados
user     = enviadados
password =                           <-- ALTERAR (senha do Postgres)

[firebird]
host     =
port     = 3050
database = C:\Dados\BANCO.FDB        <-- ALTERAR (caminho do banco Firebird)
user     = SYSDBA
password = masterkey
charset  = WIN1252
; fbclient = C:\Windows\System32\fbclient.dll

[enviadados]
id_tenant = 1                        <-- ALTERAR (número único desta loja)

[app]
secret_key = obs-secret-2026
anthropic_api_key =                  <-- ALTERAR (chave da API Anthropic para contagem por imagem)

[zapi]
instance_id    =                     <-- ALTERAR (ID da instância, painel Z-API)
token          =                     <-- ALTERAR (token da instância, painel Z-API)
client_token   =                     <-- ALTERAR (Seguranca > Client-Token, no painel Z-API)
numero_destino =                     <-- ALTERAR (WhatsApp do gestor p/ alertas, ex: 5511999999999)

[sync]
intervalo_minutos   = 15
retry_tentativas    = 3
retry_espera_s      = 5
log_arquivo         = sync_log.txt
ultimo_sync_arquivo = ultimo_sync.json
