[postgres]
host     = 108.174.148.133
port     = 5432
database = enviadados
user     = enviadados
password = Gab@311284

[firebird]
host     =
port     = 3050
database = C:\Dados\BANCO.FDB        <-- ALTERAR (caminho do banco Firebird)
user     = SYSDBA
password = masterkey
charset  = WIN1252
; fbclient = C:\Windows\System32\fbclient.dll

[enviadados]
id_tenant = 1                        <-- ALTERAR (número único desta loja)

[sync]
intervalo_minutos   = 15
retry_tentativas    = 3
retry_espera_s      = 5
log_arquivo         = sync_log.txt
ultimo_sync_arquivo = ultimo_sync.json

[media]
dir         = /var/www/enviadados/media
public_base = https://obsidian-envia.duckdns.org/media

[gupshup]
; Token secreto usado como sufixo na URL do webhook (?token=...).
; Configure a mesma string no painel Gupshup em Callback URL:
;   https://obsidian-envia.duckdns.org/api/gupshup/webhook?token=<mesma_string>
; Se ficar vazio, o webhook aceita qualquer POST (não recomendado em produção).
webhook_token = trocar-por-string-aleatoria-longa   <-- ALTERAR
